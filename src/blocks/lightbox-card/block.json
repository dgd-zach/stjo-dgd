{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "stjo/lightbox-card",
	"title": "Links that open Lightboxes",
	"category": "widgets",
	"icon": "external",
	"description": "A link or card that opens a lightbox. The lightbox body comes from the Content field, or from a WordPress page so editors can maintain it like any other page. The Arrow Link style shows only the link label.",
	"attributes": {
		"title": {
			"type": "string",
			"default": "Lightbox Link"
		},
		"linkLabel": {
			"type": "string",
			"default": "Explore"
		},
		"content": {
			"type": "string",
			"default": ""
		},
		"linkText": {
			"type": "string",
			"default": "Learn More"
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"linkNewTab": {
			"type": "boolean",
			"default": false
		},
		"mediaId": {
			"type": "number",
			"default": 0
		},
		"mediaUrl": {
			"type": "string",
			"default": ""
		},
		"mediaAlt": {
			"type": "string",
			"default": ""
		},
		"contentPageId": {
			"type": "number",
			"default": 0
		}
	},
	"styles": [
		{
			"name": "image",
			"label": "Card - With image",
			"isDefault": true
		},
		{
			"name": "text",
			"label": "Card - Text only"
		},
		{
			"name": "arrow-link",
			"label": "Arrow Link"
		}
	],
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"link": false
		}
	},
	"textdomain": "stjo",
	"editorScript": "stjo-lightbox-card-editor",
	"viewScript": "file:./view.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
